# Example Environment Variables Template for Mini HRMS

# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/mini_hrms?schema=public"

# Session JWT Authentication Secret (Use a min 32-character random string in production)
JWT_SECRET="your-32-character-secret-key-goes-here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
